{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whiteboard",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-16",
  // "account_id": "<YOUR_CLOUDFLARE_ACCOUNT_ID>",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Encrypted share links and encrypted live-session images. Nothing in it can be read without the link's key.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "whiteboard-files" }],
  // One Durable Object per live session: relays encrypted messages, keeps the latest encrypted scene.
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Per-address limits (requests per 60 s); keep in step with RATE_LIMITS in src/shared/limits.ts.
  "ratelimits": [
    { "name": "LINK_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "ROOM_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "FILE_LIMIT", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
  ],
  // Optional custom domain (replace with yours):
  // "routes": [{ "pattern": "whiteboard.example.com", "custom_domain": true }],
  // "workers_dev": false,
  // "preview_urls": false,
  "observability": { "enabled": true }
}
